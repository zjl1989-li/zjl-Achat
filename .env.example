# CodeBuddy official API Key for achat W-class cli-key adapter.
# Get it at: https://copilot.tencent.com/profile/  (China)
#          or https://www.codebuddy.ai/profile/keys  (International)
# Paste your key after '=' (no quotes, no spaces). This file is git-ignored.
CODEBUDDY_API_KEY=

# China edition only: must be 'internal' for the CLI to route correctly.
CODEBUDDY_INTERNET_ENVIRONMENT=internal

# B-class agents (北辰 / 投资研究) call the DeepSeek API directly and read this.
DEEPSEEK_API_KEY=

# Optional: override the CodeBuddy CLI binary path.
# Default: the CLI bundled inside the installed WorkBuddy desktop app
# (C:\Users\<user>\AppData\Local\Programs\WorkBuddy\resources\app.asar.unpacked\cli\bin\codebuddy)
# CODEBUDDY_CLI_PATH=C:\Users\<user>\AppData\Local\Programs\WorkBuddy\resources\app.asar.unpacked\cli\bin\codebuddy
